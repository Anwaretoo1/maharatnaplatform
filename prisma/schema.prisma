// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   // 'craftsman' | 'learner' | 'admin'
  bio       String?  @db.Text
  skills    String?  // Stored as JSON string or comma-separated
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses   Course[]
  donations Donation[] // Donations received (if craftsman)
  enrollments Enrollment[]
  progress    Progress[]

  resetToken       String?  @unique
  resetTokenExpiry DateTime?
}

model Course {
  id           String   @id @default(uuid())
  title        String
  description  String   @db.Text
  category     String
  creatorId    String
  thumbnailUrl String?
  isFree       Boolean  @default(false)
  price        Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  creator      User     @relation(fields: [creatorId], references: [id])
  content      CourseContent[]
  enrollments  Enrollment[]
}

model CourseContent {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  type      String   // 'video' | 'image' | 'text' | 'file'
  content   String   @db.Text
  order     Int
  
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress  Progress[]
}

model Donation {
  id            String   @id @default(uuid())
  amount        Float
  donorName     String
  donorEmail    String
  recipientType String   // 'platform' | 'craftsman'
  recipientId   String?
  message       String?  @db.Text
  createdAt     DateTime @default(now())

  recipient     User?    @relation(fields: [recipientId], references: [id])
}

model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model Progress {
  id              String   @id @default(uuid())
  userId          String
  courseContentId String
  isCompleted     Boolean  @default(false)
  lastPosition    Int?     // For video timestamp in seconds
  updatedAt       DateTime @updatedAt

  user            User          @relation(fields: [userId], references: [id])
  content         CourseContent @relation(fields: [courseContentId], references: [id])

  @@unique([userId, courseContentId])
}

