// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   // 'craftsman' (instructor) | 'learner' | 'admin'
  bio       String?  @db.Text
  skills    String?  // Stored as JSON string or comma-separated
  avatar    String?
  profileImage String? // Profile photo URL
  lastSeen  DateTime? // Track online status
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses   Course[]
  donations Donation[] // Donations received (if instructor/craftsman)
  enrollments Enrollment[]
  progress    Progress[]
  notifications Notification[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  blockedUsers     BlockedUser[] @relation("Blocker")
  blockedBy        BlockedUser[] @relation("Blocked")
  usedCodes        EnrollmentCode[]
  discounts        Discount[]

  resetToken       String?  @unique
  resetTokenExpiry DateTime?
}

model Course {
  id           String   @id @default(uuid())
  title        String
  description  String   @db.Text
  category     String
  creatorId    String
  thumbnailUrl String?
  isFree       Boolean  @default(false)
  price        Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  creator      User     @relation(fields: [creatorId], references: [id])
  content      CourseContent[]
  enrollments  Enrollment[]
  enrollmentCodes EnrollmentCode[]
  discounts    Discount[]
}

model Discount {
  id           String   @id @default(uuid())
  courseId      String?  // null = global discount (all paid courses)
  percentage   Float    // e.g. 20 for 20%
  description  String?  @db.Text
  isActive     Boolean  @default(true)
  startDate    DateTime @default(now())
  endDate      DateTime
  createdById  String
  createdAt    DateTime @default(now())

  course       Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy    User     @relation(fields: [createdById], references: [id])
}

model CourseContent {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  type      String   // 'video' | 'image' | 'text' | 'file'
  content   String   @db.Text
  order     Int
  
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress  Progress[]
}

model Donation {
  id            String   @id @default(uuid())
  amount        Float
  donorName     String
  donorEmail    String
  recipientType String   // 'platform' | 'craftsman'
  recipientId   String?
  message       String?  @db.Text
  createdAt     DateTime @default(now())

  recipient     User?    @relation(fields: [recipientId], references: [id])
}

model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model Progress {
  id              String   @id @default(uuid())
  userId          String
  courseContentId String
  isCompleted     Boolean  @default(false)
  lastPosition    Int?     // For video timestamp in seconds
  updatedAt       DateTime @updatedAt

  user            User          @relation(fields: [userId], references: [id])
  content         CourseContent @relation(fields: [courseContentId], references: [id])

  @@unique([userId, courseContentId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   // 'new_course' | 'new_lesson' | 'system' | 'password_changed'
  isRead    Boolean  @default(false)
  link      String?  // Optional link to navigate to
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  subject    String?
  content    String   @db.Text
  imageUrl   String?  // Image attachment (payment receipt, etc.)
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, isRead])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model EnrollmentCode {
  id        String   @id @default(uuid())
  code      String   @unique
  courseId   String
  isUsed    Boolean  @default(false)
  usedById  String?
  createdAt DateTime @default(now())
  usedAt    DateTime?

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  usedBy    User?    @relation(fields: [usedById], references: [id])
}

