# ===================================
# متغيرات البيئة - منصة مهاراتنا
# ===================================
# انسخ هذا الملف وأعد تسميته إلى .env
# ثم املأ القيم المطلوبة

# === قاعدة البيانات (مطلوب) ===
# رابط الاتصال بقاعدة بيانات MySQL
# يمكنك الحصول عليه من PlanetScale أو Railway أو Aiven
DATABASE_URL="mysql://user:password@host:3306/database_name"

# === مفتاح JWT السري (مطلوب) ===
# مفتاح سري لتشفير جلسات المستخدمين
# استخدم سلسلة عشوائية طويلة (يمكنك توليدها من: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-this"

# === Supabase (اختياري - لتخزين الملفات) ===
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# === البريد الإلكتروني SMTP (مطلوب - لإعادة تعيين كلمة المرور والإخطارات) ===
# منصتنا تستخدم SendGrid لإرسال الرسائل البريدية
# الحصول على API Key:
# 1. اذهب إلى https://sendgrid.com
# 2. إنشء حساب مجاني أو تسجيل الدخول
# 3. Settings → API Keys → Create API Key
# قم بنسخ المفتاح والصقه في SMTP_PASS

SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="SG.your-sendgrid-api-key-here"
SMTP_FROM="noreply@maharat-syria.com"

# === رابط التطبيق (مطلوب) ===
# استخدم رابط الإنتاج الفعلي (مثل domain.com أو vercel deployment)
# هذا الرابط يستخدم في رسائل البريد الإلكتروني وروابط إعادة تعيين كلمة المرور
NEXT_PUBLIC_APP_URL="https://maharat-syria.com"
# === Cloudinary (مطلوب - لرفع الصور والفيديو) ===
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# === Stripe (مطلوب - للدفع) ===
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."